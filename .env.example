# Supabase Postgres (Project Settings → Database)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings → API) — emails use Dashboard → Auth → SMTP
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only — Storage uploads (resumes bucket). Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth.js session for the website dashboard
AUTH_SECRET="replace-me"
# Development: http://localhost:43123
# Production (Vercel): https://crackjob.co  — do not leave localhost on live
AUTH_URL="http://localhost:43123"
# Optional: NEXT_PUBLIC_APP_URL="https://crackjob.co"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://crackjob.co
#   Redirect URLs: https://crackjob.co/**  and  http://localhost:43123/**


# OpenAI / ChatGPT (optional — demo solve if key is empty)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_FAST_MODEL="gpt-4.1-mini"
OPENAI_NANO_MODEL="gpt-4.1-nano"
OPENAI_VISION_MODEL="gpt-4.1-mini"
OPENAI_WHISPER_MODEL="gpt-transcribe"
OPENAI_IMAGE_DETAIL="high"
OPENAI_MAX_TOKENS="2400"
OPENAI_SCREENSHOT_MAX_TOKENS="1600"
OPENAI_VOICE_MAX_TOKENS="1200"
OPENAI_VISION_MAX_TOKENS="450"
OPENAI_IMAGE_MAX_WIDTH="1280"
OPENAI_IMAGE_QUALITY="80"
OPENAI_CHEAP_MODE="true"
SKIP_AUTH="false"
# Local-only: mint a session for dev@localhost without Supabase. Keep false for real login.
DEV_DESKTOP_LOGIN="false"

# Razorpay (Dashboard → API Keys; Test mode first)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your_key_secret"
# Optional until webhook is configured in Razorpay Dashboard
# URL: https://crackjob.co/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""
