# Supabase Postgres (Project Settings → Database)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings → API) — emails use Dashboard → Auth → SMTP
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Auth.js session for the website dashboard
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:43123"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI / ChatGPT (optional — demo solve if key is empty)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_FAST_MODEL="gpt-4.1-mini"
OPENAI_VISION_MODEL="gpt-4.1-mini"
OPENAI_WHISPER_MODEL="whisper-1"
OPENAI_IMAGE_DETAIL="low"
OPENAI_MAX_TOKENS="900"
OPENAI_SCREENSHOT_MAX_TOKENS="480"
OPENAI_VISION_MAX_TOKENS="450"
OPENAI_IMAGE_MAX_WIDTH="640"
OPENAI_IMAGE_QUALITY="60"
OPENAI_CHEAP_MODE="true"
AI_DEMO_MODE=""
SKIP_AUTH="false"
# Local-only: mint a session for dev@localhost without Supabase. Keep false for real login.
DEV_DESKTOP_LOGIN="false"
