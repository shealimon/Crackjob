{
  "name": "interview-pilot",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "bump:msi-version": "node scripts/bump-msi-version.mjs",
    "wix:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-wix-installer-assets.ps1",
    "test:contracts": "npx --yes tsx src/lib/taskSession.verify.ts && npx --yes tsx src/lib/activeScreenshot.verify.ts && npx --yes tsx src/lib/interactiveOrchestration.verify.ts && npx --yes tsx src/lib/interactiveCapture.verify.ts && npx --yes tsx src/lib/interactiveTaskContext.verify.ts && npx --yes tsx src/lib/interactive-live-scenarios.verify.ts && npx --yes tsx src/lib/interviewSpeech.verify.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
