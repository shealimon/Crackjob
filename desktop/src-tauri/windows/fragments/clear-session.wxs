<?xml version="1.0" encoding="utf-8"?>
<!--
  On every MSI install/reinstall:
  - delete roaming session.json (token + remember-me credentials)
  - set HKCU flag so the app also clears auth on first launch (covers elevated-installer AppData edge cases)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="AppDataFolder">
        <Directory Id="CrackRoamingAppData" Name="com.interviewpilot.desktop">
          <Component Id="ClearSessionOnInstall" Guid="c8e4f1a2-9b3d-4e6f-8a1c-2d5e7f90b4c1">
            <RemoveFile Id="RemoveCrackSessionJsonInstall" Name="session.json" On="install" />
            <RemoveFile Id="RemoveCrackSessionJsonUninstall" Name="session.json" On="uninstall" />
            <!-- ICE64: user-profile dirs created by the installer must be removable -->
            <RemoveFolder Id="RemoveCrackRoamingAppData" Directory="CrackRoamingAppData" On="uninstall" />
            <RegistryValue
              Root="HKCU"
              Key="Software\CrackJob\Host Process for Crackjob Services"
              Name="ClearSessionOnLaunch"
              Type="integer"
              Value="1"
              KeyPath="yes"
            />
          </Component>
        </Directory>
      </Directory>
    </DirectoryRef>
  </Fragment>
</Wix>
